# Copy to secrets.toml and choose your own long password.
ADMIN_PASSWORD = "replace-with-a-long-private-password"

# Supabase (server only). Run supabase/setup.sql before enabling.
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_SECRET_KEY = "sb_secret_REPLACE_LOCALLY"
SUPABASE_STORAGE_BUCKET = "presentaciones"

STORAGE_BACKEND = "supabase"

# Optional: automatic recovery emails. Without these, recovery goes through the organizer.
RESEND_API_KEY = ""
RESEND_FROM = ""
